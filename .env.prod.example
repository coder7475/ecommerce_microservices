# ========================================================
# Global Infrastructure Configuration (Production Template)
# ========================================================
POSTGRES_USER=prod_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=app_db
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,product_db,inventory_db,order_db,email_db,kong_db,keycloak_db

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=prod_rabbit_user
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_PASSWORD

MAIL_SMTP_HOST=smtp.sendgrid.net
MAIL_SMTP_PORT=587

# ========================================================
# Host Exposed Service Ports
# ========================================================
API_GATEWAY_PORT=3000
PRODUCT_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
AUTH_SERVICE_PORT=3003
USER_SERVICE_PORT=3004
EMAIL_SERVICE_PORT=3005
CART_SERVICE_PORT=3006
ORDER_SERVICE_PORT=3007

# ========================================================
# Inter-Service Internal URLs (Container Network)
# ========================================================
PRODUCT_SERVICE_URL=http://product-service:3001/api
INVENTORY_SERVICE_URL=http://inventory-service:3002/api
AUTH_SERVICE_URL=http://auth-service:3003/api
USER_SERVICE_URL=http://user-service:3004/api
EMAIL_SERVICE_URL=http://email-service:3005/api
CART_SERVICE_URL=http://cart-service:3006/api
ORDER_SERVICE_URL=http://order-service:3007/api

# ========================================================
# Microservice Database Connection Strings (Multi-DB)
# ========================================================
DATABASE_URL_AUTH="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/auth_db"
DATABASE_URL_USER="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/user_db"
DATABASE_URL_PRODUCT="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/product_db"
DATABASE_URL_INVENTORY="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/inventory_db"
DATABASE_URL_ORDER="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/order_db"
DATABASE_URL_EMAIL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/email_db"

# ========================================================
# Message Queue & Shared Secrets
# ========================================================
QUEUE_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672"
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_JWT_SECRET
CART_TTL=3600
DEFAULT_SENDER_MAIL="orders@yourcompany.com"
