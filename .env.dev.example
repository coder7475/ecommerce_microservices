# ========================================================
# Global Infrastructure Configuration (Development)
# ========================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=app_db
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=auth_db,user_db,product_db,inventory_db,order_db,email_db,kong_db,keycloak_db

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

REDIS_HOST=redis-stack
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# ========================================================
# Host Exposed Service Ports
# ========================================================
API_GATEWAY_PORT=3000
PRODUCT_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
AUTH_SERVICE_PORT=3003
USER_SERVICE_PORT=3004
EMAIL_SERVICE_PORT=3005
CART_SERVICE_PORT=3006
ORDER_SERVICE_PORT=3007

# ========================================================
# Inter-Service Internal URLs (Container Network)
# ========================================================
PRODUCT_SERVICE_URL=http://product-service:3001/api
INVENTORY_SERVICE_URL=http://inventory-service:3002/api
AUTH_SERVICE_URL=http://auth-service:3003/api
USER_SERVICE_URL=http://user-service:3004/api
EMAIL_SERVICE_URL=http://email-service:3005/api
CART_SERVICE_URL=http://cart-service:3006/api
ORDER_SERVICE_URL=http://order-service:3007/api

# ========================================================
# Microservice Database Connection Strings (Multi-DB)
# ========================================================
DATABASE_URL_AUTH="postgresql://admin:admin123@postgres:5432/auth_db"
DATABASE_URL_USER="postgresql://admin:admin123@postgres:5432/user_db"
DATABASE_URL_PRODUCT="postgresql://admin:admin123@postgres:5432/product_db"
DATABASE_URL_INVENTORY="postgresql://admin:admin123@postgres:5432/inventory_db"
DATABASE_URL_ORDER="postgresql://admin:admin123@postgres:5432/order_db"
DATABASE_URL_EMAIL="postgresql://admin:admin123@postgres:5432/email_db"

# ========================================================
# Message Queue & Shared Secrets
# ========================================================
QUEUE_URL="amqp://guest:guest@rabbitmq:5672"
JWT_SECRET="super-secret-development-jwt-key"
CART_TTL=3600
DEFAULT_SENDER_MAIL="admin@example.com"
